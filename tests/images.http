@host = http://localhost:3000
@token = TEST_TOKEN

###
# @name UploadRejectsAnonymous
POST {{host}}/api/images
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="landscape.jpg"
Content-Type: image/jpeg

< ./fixtures/landscape.jpg
--WebAppBoundary--

?? status == 401

###
# @name Upload
POST {{host}}/api/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="lat"

31.7683
--WebAppBoundary
Content-Disposition: form-data; name="lng"

35.2137
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="landscape.jpg"
Content-Type: image/jpeg

< ./fixtures/landscape.jpg
--WebAppBoundary--

?? status == 201
?? js response.parsedBody.osmUser == test-user
?? js response.parsedBody.license == CC0-1.0
?? js response.parsedBody.location.lat == 31.7683
?? js response.parsedBody.id.length == 32

###
# @name UploadingTheSameImageAgainReturnsTheSameId
POST {{host}}/api/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="landscape.jpg"
Content-Type: image/jpeg

< ./fixtures/landscape.jpg
--WebAppBoundary--

?? status == 200
?? js response.parsedBody.id == {{Upload.id}}

###
# @name UploadRejectsStatedUploaderFromANonModerator
POST {{host}}/api/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="osmUser"

someone-else
--WebAppBoundary
Content-Disposition: form-data; name="osmUserId"

12345
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 403

###
# @name AModeratorMayGiveTheDateWithoutNamingAnUploader
POST {{host}}/api/images
Authorization: Bearer TEST_ADMIN_TOKEN
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="uploadedAt"

2018-03-04T09:00:00Z
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 201
?? js response.parsedBody.osmUser == test-admin
?? js response.parsedBody.osmUserId == test-admin-id
?? js response.parsedBody.uploadedAt == 2018-03-04T09:00:00Z

###
# @name CleanUpTheAnonymousOne
DELETE {{host}}/api/images/{{AModeratorMayGiveTheDateWithoutNamingAnUploader.id}}
Authorization: Bearer TEST_ADMIN_TOKEN

?? status == 204

###
# @name UploadRejectsAnIdWithoutTheNameItBelongsTo
POST {{host}}/api/images
Authorization: Bearer TEST_ADMIN_TOKEN
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="osmUserId"

12345
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 400

###
# @name UploadRejectsALicenseThatIsNotPermissive
POST {{host}}/api/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="license"

CC-BY-SA-4.0
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 400
?? js response.parsedBody.errors[0].path == /body/license

###
# @name UploadRejectsALatitudeOutOfRange
POST {{host}}/api/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="lat"

91
--WebAppBoundary
Content-Disposition: form-data; name="lng"

35
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 400
?? js response.parsedBody.errors[0].path == /body/lat

###
# @name ModeratorStatesWhoTheImageBelongsTo
POST {{host}}/api/images
Authorization: Bearer TEST_ADMIN_TOKEN
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="osmUser"

GorALexeY
--WebAppBoundary
Content-Disposition: form-data; name="osmUserId"

357541
--WebAppBoundary
Content-Disposition: form-data; name="uploadedAt"

2019-05-27T12:08:18Z
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 201
?? js response.parsedBody.osmUser == GorALexeY
?? js response.parsedBody.osmUserId == 357541
?? js response.parsedBody.uploadedAt == 2019-05-27T12:08:18Z

###
# @name TheStatedUploaderCannotBeDeletedByTheModeratorsOwnToken
DELETE {{host}}/api/images/{{ModeratorStatesWhoTheImageBelongsTo.id}}
Authorization: Bearer TEST_ADMIN_TOKEN

?? status == 204

###
# @name AnImageWhoseOsmAccountIsGoneIsCreditedByNameAlone
POST {{host}}/api/images
Authorization: Bearer TEST_ADMIN_TOKEN
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="osmUser"

VELOCITY_club
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="other.jpg"
Content-Type: image/jpeg

< ./fixtures/other.jpg
--WebAppBoundary--

?? status == 201
?? js response.parsedBody.osmUser == VELOCITY_club
?? js response.parsedBody.osmUserId == undefined

###
# @name ItCannotBeDeletedByAnyoneButAModerator
DELETE {{host}}/api/images/{{AnImageWhoseOsmAccountIsGoneIsCreditedByNameAlone.id}}
Authorization: Bearer {{token}}

?? status == 403

###
# @name ButAModeratorCan
DELETE {{host}}/api/images/{{AnImageWhoseOsmAccountIsGoneIsCreditedByNameAlone.id}}
Authorization: Bearer TEST_ADMIN_TOKEN

?? status == 204

###
# @name GetImage
GET {{host}}/{{Upload.id}}.jpg

?? status == 200
?? header Content-Type == image/jpeg
?? header Cache-Control contains immutable

{{
  exports.originalLength = response.headers['content-length'];
}}

###
# @name GetMetadata
GET {{host}}/{{Upload.id}}.json

?? status == 200
?? js response.parsedBody.osmUser == test-user
?? js response.parsedBody.url endsWith .jpg

###
# @name GetPage
GET {{host}}/{{Upload.id}}

?? status == 200
?? header Content-Type contains text/html
?? body contains Image by test-user
?? body contains https://www.openstreetmap.org/user/test-user
?? body contains CC0-1.0
?? body contains og:image
?? body contains rel="icon"

###
# @name FaviconRedirectsToTheSiteItBelongsTo
# @no-redirect
GET {{host}}/favicon.ico

?? status == 301
?? header Location contains favicon

###
# @name GetPageOfAnUnknownImage
GET {{host}}/00000000000000000000000000000000

?? status == 404

###
# @name GetThumbnail
GET {{host}}/{{Upload.id}}.jpg?width=250

?? status == 200
?? header Content-Type == image/jpeg

###
# @name GetThumbnailAgainIsServedFromDisk
GET {{host}}/{{Upload.id}}.jpg?width=250

?? status == 200

###
# @name AWidthAtLeastAsWideAsThePictureIsThePictureItself
GET {{host}}/{{Upload.id}}.jpg?width=1920

?? status == 200
?? header Content-Type == image/jpeg
# The fixture is 1200 wide, so a width of 1920 can only be the original itself rather than a
# re-encode of it, and it is served as the very same bytes.
?? js response.headers['content-length'] == {{originalLength}}

###
# @name UnsupportedThumbnailWidth
GET {{host}}/{{Upload.id}}.jpg?width=137

?? status == 400

###
# @name UnknownImage
GET {{host}}/00000000000000000000000000000000.jpg

?? status == 404

###
# @name MalformedIdIsRejected
GET {{host}}/not-an-id.jpg

?? status == 400

###
# @name DeleteRejectsAnonymous
DELETE {{host}}/api/images/{{Upload.id}}

?? status == 401

###
# @name Delete
DELETE {{host}}/api/images/{{Upload.id}}
Authorization: Bearer {{token}}

?? status == 204

###
# @name DeletedImageIsGone
GET {{host}}/{{Upload.id}}.jpg

?? status == 404
