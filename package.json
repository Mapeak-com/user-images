{
  "name": "user-images",
  "version": "1.0.0",
  "description": "A microservice to store the images users attach to points of interest",
  "main": "index.ts",
  "scripts": {
    "generate-json": "js-yaml ./user-images.openapi.yml > ./src/user-images.openapi.json",
    "build": "npm run generate-json && tsc && node -e \"require('node:fs').cpSync('src/templates', 'dist/templates', { recursive: true })\"",
    "start": "node dist/index.js",
    "test:fixtures": "node ./tests/generate-fixtures.mjs",
    "test:http": "npm run test:fixtures && httpyac ./tests/*.http --all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mapeak-com/user-images.git"
  },
  "author": "Harel Mazor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mapeak-com/user-images/issues"
  },
  "homepage": "https://github.com/Mapeak-com/user-images#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.4.1",
    "@types/swagger-ui-express": "^4.1.8",
    "httpyac": "^6.16.0",
    "js-yaml": "^5.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exif-reader": "^2.0.3",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "lru-cache": "^11.2.5",
    "multer": "^2.0.2",
    "mustache": "^4.2.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1"
  }
}
